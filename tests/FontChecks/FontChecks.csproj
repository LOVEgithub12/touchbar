<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net6.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable><PlatformTarget>x64</PlatformTarget>
    <AppDependencies>../../WindowsTouchBar-master/WindowsTouchBar/bin/Release/net6.0-windows</AppDependencies>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../WindowsTouchBar-master/WindowsTouchBar/Helpers/LyricsFontResolver.cs" Link="LyricsFontResolver.cs" />
    <Compile Include="../../WindowsTouchBar-master/WindowsTouchBar/Helpers/LyricsTextLayout.cs" Link="LyricsTextLayout.cs" />
    <Reference Include="SkiaSharp"><HintPath>$(AppDependencies)/SkiaSharp.dll</HintPath></Reference>
    <None Include="$(AppDependencies)/runtimes/win-x64/native/libSkiaSharp.dll" Link="libSkiaSharp.dll" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
