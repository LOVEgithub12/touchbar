<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net6.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PlatformTarget>x64</PlatformTarget>
    <AppSource>../../WindowsTouchBar-master/WindowsTouchBar</AppSource>
    <AppDependencies>$(AppSource)/bin/Release/net6.0-windows</AppDependencies>
  </PropertyGroup>
  <ItemGroup>
    <None Include="$(AppSource)/Resources/foobar2000.png" Link="Resources/foobar2000.png" CopyToOutputDirectory="PreserveNewest" />
    <Compile Include="$(AppSource)/Components/Button.cs" Link="App/Button.cs" />
    <Compile Include="$(AppSource)/Components/MediaIconButton.cs" Link="App/MediaIconButton.cs" />
    <Compile Include="$(AppSource)/Components/Spacer.cs" Link="App/Spacer.cs" />
    <Compile Include="$(AppSource)/Components/IComponent.cs" Link="App/IComponent.cs" />
    <Compile Include="$(AppSource)/Components/ITouchComponent.cs" Link="App/ITouchComponent.cs" />
    <Compile Include="$(AppSource)/Commands/*.cs" Link="App/Commands/%(Filename)%(Extension)" />
    <Compile Include="$(AppSource)/Models/*.cs" Link="App/Models/%(Filename)%(Extension)" />
    <Compile Include="$(AppSource)/Lyrics/*.cs" Link="App/Lyrics/%(Filename)%(Extension)" />
    <Compile Include="$(AppSource)/Views/*.cs" Link="App/Views/%(Filename)%(Extension)" />
    <Compile Include="$(AppSource)/Helpers/ForegroundTracker.cs" Link="App/ForegroundTracker.cs" />
    <Compile Include="$(AppSource)/Helpers/LyricsFontResolver.cs" Link="App/LyricsFontResolver.cs" />
    <Compile Include="$(AppSource)/Helpers/LyricsTextLayout.cs" Link="App/LyricsTextLayout.cs" />
    <Compile Include="$(AppSource)/Interop/BrightlessAPI.cs" Link="App/BrightlessAPI.cs" />
    <Compile Include="$(AppSource)/Interop/NativeBrightnessOsd.cs" Link="App/NativeBrightnessOsd.cs" />
    <Compile Include="$(AppSource)/Interop/ControlDiagnostics.cs" Link="App/ControlDiagnostics.cs" />
    <Compile Include="$(AppSource)/Interop/KeyboardBacklightAPI.cs" Link="App/KeyboardBacklightAPI.cs" />
    <Compile Include="$(AppSource)/Device/Hid/TouchReport.cs" Link="App/TouchReport.cs" />
    <Compile Include="$(AppSource)/Events/TouchEventArgs.cs" Link="App/TouchEventArgs.cs" />
    <Reference Include="SkiaSharp"><HintPath>$(AppDependencies)/SkiaSharp.dll</HintPath></Reference>
    <Reference Include="SkiaSharp.Elements"><HintPath>$(AppDependencies)/SkiaSharp.Elements.dll</HintPath></Reference>
    <Reference Include="WindowsInput"><HintPath>$(AppDependencies)/WindowsInput.dll</HintPath></Reference>
    <Reference Include="System.Management"><HintPath>$(AppDependencies)/System.Management.dll</HintPath></Reference>
    <Reference Include="HidSharp"><HintPath>$(AppDependencies)/HidSharp.dll</HintPath></Reference>
    <None Include="$(AppDependencies)/runtimes/win-x64/native/libSkiaSharp.dll" Link="libSkiaSharp.dll" CopyToOutputDirectory="PreserveNewest" />
    <None Include="$(AppSource)/settings.json" Link="settings.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
