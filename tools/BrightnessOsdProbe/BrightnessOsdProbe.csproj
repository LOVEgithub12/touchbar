<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net6.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PlatformTarget>x64</PlatformTarget>
    <AppSource>../../WindowsTouchBar-master/WindowsTouchBar</AppSource>
    <AppDependencies>$(AppSource)/bin/Release/net6.0-windows</AppDependencies>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="SkiaSharp"><HintPath>$(AppDependencies)/SkiaSharp.dll</HintPath></Reference>
    <None Include="$(AppDependencies)/runtimes/win-x64/native/libSkiaSharp.dll" Link="libSkiaSharp.dll" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
